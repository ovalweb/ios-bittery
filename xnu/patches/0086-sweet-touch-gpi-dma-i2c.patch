+	/* gpi_alloc_ev_chan: every slot but one handed to the engine */
+	if (!touch_gpi_cmd(-1, GPI_CMD_ALLOC, GPI_ALLOCATED)) {
+		return false;
+	}
+	uint32_t ev = GPI_EV(n);
+	uint64_t pa = st.dma_pa + GPI_EV_OFF;
+	touch_wr(st.gpi, ev + GPI_CTX_CONFIG, (GPI_EL << 24) | (1u << 16) | 2u);
+	touch_wr(st.gpi, ev + GPI_CTX_LEN, GPI_EV_LEN);
+	touch_wr(st.gpi, ev + GPI_CTX_BASE_LO, (uint32_t)pa);
+	touch_wr(st.gpi, ev + GPI_CTX_BASE_HI, (uint32_t)(pa >> 32));
+	touch_wr(st.gpi, GPI_EV_DB(n) + 4u, (uint32_t)(pa >> 32));
+	const uint32_t ctx0[] = {GPI_CTX_INT_MOD, GPI_CTX_MSI_LO, GPI_CTX_MSI_HI,
+		                 GPI_CTX_RPU_LO, GPI_CTX_RPU_HI};
+	for (unsigned i = 0; i < sizeof(ctx0) / sizeof(ctx0[0]); ++i) {
+		touch_wr(st.gpi, ev + ctx0[i], 0);
+	}
+	st.ev_rp = 0;
+	touch_wr(st.gpi, GPI_EV_DB(n), (uint32_t)(pa + GPI_EV_LEN - GPI_EL));
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!touch_gpi_cmd((int)k, GPI_CMD_ALLOC, GPI_ALLOCATED)) {
+			return false;
+		}
+		touch_gpi_program(k);
+	}
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!touch_gpi_cmd((int)k, GPI_CMD_START, GPI_STARTED)) {
+			return false;
+		}
+	}
+	printf("SWEET TOUCH: gpi %#x gpii %u se %u started, dma %#llx, event rp %#x\n",
+	    tb.gpi_pa, n, tb.gpi_seid, (unsigned long long)st.dma_pa,
+	    touch_rd(st.gpi, ev + GPI_CTX_RP_LO));
+	return true;
+}
