+static void
+touch_dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(st.dma_pa + off), len, TRUE);
+}
+
+static void
+touch_dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(st.dma_pa + off), len, TRUE);
+}
+
+static unsigned
+touch_gpi_state(uint32_t ctx)
+{
+	return (touch_rd(st.gpi, ctx + GPI_CTX_CONFIG) >> 20) & 15u;
+}
+
+/* Command for channel k, or the event ring when k < 0; poll for the state it leads to. */
+static bool
+touch_gpi_cmd(int k, unsigned opcode, unsigned want)
+{
+	uint32_t g = GPI_GPII(st.gpii);
+	uint32_t ctx = k < 0 ? GPI_EV(st.gpii) : GPI_CH(st.gpii, (unsigned)k);
+	touch_wr(st.gpi, g + (k < 0 ? GPI_EV_CMD : GPI_CH_CMD),
+	    (opcode << 24) | (k < 0 ? 0u : (uint32_t)k));
+	for (unsigned i = 0; i < 10000; ++i) {  /* 100 ms; Linux allows 250 */
+		if (touch_gpi_state(ctx) == want) {
+			touch_wr(st.gpi, g + GPI_CH_IRQ_CLR, touch_rd(st.gpi, g + GPI_CH_IRQ));
+			touch_wr(st.gpi, g + GPI_EV_IRQ_CLR, touch_rd(st.gpi, g + GPI_EV_IRQ));
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET TOUCH: gpi gpii %u %s %d cmd %u: state %u, want %u (error log %#x glob %#x gpii %#x)\n",
+	    st.gpii, k < 0 ? "ev" : "ch", k, opcode, touch_gpi_state(ctx), want,
+	    touch_rd(st.gpi, g + GPI_ERROR_LOG), touch_rd(st.gpi, g + GPI_GLOB_STTS),
+	    touch_rd(st.gpi, g + GPI_GPII_STTS));
+	return false;
+}
+
+/* Channel context after ALLOCATE or RESET (gpi_alloc_chan); the ring starts empty. */
+static void
+touch_gpi_program(unsigned k)
+{
+	uint32_t ctx = GPI_CH(st.gpii, k);
+	uint64_t pa = st.dma_pa + (k ? GPI_RX_OFF : GPI_TX_OFF);
+	/* element size, event ring 0, TX is the OUT direction, GPI channel type */
+	touch_wr(st.gpi, ctx + GPI_CTX_CONFIG, (GPI_EL << 24) | ((k ? 0u : 1u) << 3) | 2u);
+	touch_wr(st.gpi, ctx + GPI_CTX_LEN, GPI_CH_LEN);
+	touch_wr(st.gpi, ctx + GPI_CTX_BASE_LO, (uint32_t)pa);
+	touch_wr(st.gpi, ctx + GPI_CTX_BASE_HI, (uint32_t)(pa >> 32));
+	touch_wr(st.gpi, GPI_CH_DB(st.gpii, k) + 4u, (uint32_t)(pa >> 32));
+	touch_wr(st.gpi, ctx + GPI_CH_SCRATCH, ((k ^ 1u) << 16) | (GPI_PROTO_I2C << 4) | tb.gpi_seid);
+	for (unsigned i = 1; i < 4; ++i) {
+		touch_wr(st.gpi, ctx + GPI_CH_SCRATCH + 4u * i, 0);
+	}
+	touch_wr(st.gpi, ctx + GPI_CH_QOS, 1);
+	st.ch_wp[k] = 0;
+}
+
+/*
+ * Consume the events the engine wrote (the event context's RP is its write
+ * position) and hand each slot back through the event doorbell. Returns
+ * channel k's transfer result: 0 at its EOT, ENXIO/EIO on an error event,
+ * EINPROGRESS otherwise.
+ */
+static int
+touch_gpi_events(unsigned k)
+{
+	uint32_t hw = touch_rd(st.gpi, GPI_EV(st.gpii) + GPI_CTX_RP_LO);
+	int result = EINPROGRESS;
+	if ((hw ^ (uint32_t)(st.dma_pa + GPI_EV_OFF)) & ~(GPI_EV_LEN - 1u)) {
+		return result;  /* not pointing into the ring (yet) */
+	}
+	hw &= GPI_EV_LEN - 1u;
+	while (st.ev_rp != hw) {
+		uint32_t off = GPI_EV_OFF + st.ev_rp;
+		touch_dma_sync(off, GPI_EL);
+		const volatile uint32_t *e = (const volatile uint32_t *)(st.dma + off);
+		for (unsigned i = 0; i < 4; ++i) {
+			st.ev_last[i] = e[i];
+		}
+		/* dwords: TRE pointer lo/hi, length | code << 24, status | type << 16 | chid << 24 */
+		unsigned type = (st.ev_last[3] >> 16) & 0xffu, chid = st.ev_last[3] >> 24;
+		unsigned code = st.ev_last[2] >> 24;
+		if (type == GPI_EV_XFER && code == GPI_TCE_ERR) {
+			result = (st.ev_last[3] & GPI_ST_NACK) ? ENXIO : EIO;
+		} else if (type == GPI_EV_NOTIFY && (st.ev_last[0] & (SE_NACK | (3u << 12)))) {
+			/* SE M_IRQ status: GP_IRQ1 NACK, GP_IRQ3 bus error, GP_IRQ4 arbitration */
+			result = (st.ev_last[0] & SE_NACK) ? ENXIO : EIO;
+		} else if (type == GPI_EV_XFER && code == GPI_TCE_EOT && chid == k &&
+		    result == EINPROGRESS) {
+			result = 0;
+		}
+		st.ev_rp = (st.ev_rp + GPI_EL) & (GPI_EV_LEN - 1u);
+		touch_wr(st.gpi, GPI_EV_DB(st.gpii), (uint32_t)(st.dma_pa + GPI_EV_OFF +
+		    ((st.ev_rp + GPI_EV_LEN - GPI_EL) & (GPI_EV_LEN - 1u))));
+	}
+	touch_wr(st.gpi, GPI_GPII(st.gpii) + GPI_IEOB_CLR, 1);
+	return result;
+}
+
+static void
+touch_gpi_tre(unsigned k, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	uint32_t off = (k ? GPI_RX_OFF : GPI_TX_OFF) + st.ch_wp[k];
+	volatile uint32_t *t = (volatile uint32_t *)(st.dma + off);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	touch_dma_clean(off, GPI_EL);
+	st.ch_wp[k] = (st.ch_wp[k] + GPI_EL) & (GPI_CH_LEN - 1u);
+}
+
+/* Doorbell: the ring's new write position. */
+static void
+touch_gpi_ring(unsigned k)
+{
+	touch_wr(st.gpi, GPI_CH_DB(st.gpii, k),
+	    (uint32_t)(st.dma_pa + (k ? GPI_RX_OFF : GPI_TX_OFF) + st.ch_wp[k]));
+}
+
+/* After an error (gpi_terminate_all): stop both, reset (drops TREs), reprogram, start. */
+static bool
+touch_gpi_restart(void)
+{
+	for (int k = 0; k < 2; ++k) {
+		(void)touch_gpi_cmd(k, GPI_CMD_STOP, GPI_STOPPED);      /* reset regardless */
+	}
+	for (int k = 0; k < 2; ++k) {
+		if (!touch_gpi_cmd(k, GPI_CMD_RESET, GPI_ALLOCATED)) {
+			st.dead = true;
+			return false;
+		}
+		touch_gpi_program((unsigned)k);
+	}
+	for (int k = 0; k < 2; ++k) {
+		if (!touch_gpi_cmd(k, GPI_CMD_START, GPI_STARTED)) {
+			st.dead = true;
+			return false;
+		}
+	}
+	(void)touch_gpi_events(2);      /* drop what the aborted transfer left */
+	st.gpi_cfg = false;
+	return true;
+}
+
+/*
+ * touch_msg_run over GPI. TX ring: [CONFIG0] GO, then for a write the DMA
+ * TRE of the data; a read's GO carries the length and its data arrives
+ * through the RX ring's DMA TRE. Done at the EOT of the data TRE.
+ */
+static int
+touch_gpi_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	uint64_t txb = st.dma_pa + GPI_TXBUF_OFF, rxb = st.dma_pa + GPI_RXBUF_OFF;
+	if (st.dead || nt > GPI_TXBUF_LEN || nr > GPI_RXBUF_LEN || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (nr) {
+		touch_dma_sync(GPI_RXBUF_OFF, nr);
+		touch_gpi_tre(1, (uint32_t)rxb, (uint32_t)(rxb >> 32), nr, TRE_DMA | TRE_IEOT);
+		touch_gpi_ring(1);
+	} else {
+		memcpy((void *)(st.dma + GPI_TXBUF_OFF), tx, nt);
+		touch_dma_clean(GPI_TXBUF_OFF, nt);
+	}
+	if (!st.gpi_cfg) {
+		/* 100 kHz at 19.2 MHz (downstream geni_i2c_clk_map: div 7, high 10,
+		 * low 11, cycle 26), TX and RX packing, source = the SE's DFS level */
+		touch_gpi_tre(0, (3u << 24) | (26u << 16) | (10u << 8) | 11u, 0,
+		    (st.clk_level << 16) | 7u, TRE_CONFIG0 | TRE_CHAIN);
+		st.gpi_cfg = true;
+	}
+	touch_gpi_tre(0, (stretch ? 1u << 26 : 0u) | ((uint32_t)addr << 8) | (nr ? 2u : 1u),
+	    0, nr, TRE_GO | (nr ? TRE_IEOB : TRE_CHAIN));
+	if (nt) {
+		touch_gpi_tre(0, (uint32_t)txb, (uint32_t)(txb >> 32), nt, TRE_DMA | TRE_IEOT);
+	}
+	touch_gpi_ring(0);
+	int err = EINPROGRESS;
+	for (unsigned i = 0; i < 5000 && err == EINPROGRESS; ++i) {    /* 50 ms */
+		err = touch_gpi_events(nr ? 1u : 0u);
+		if (err == EINPROGRESS) {
+			delay(10);
+		}
+	}
+	if (err) {
+		if (err == EINPROGRESS) {
+			err = ETIMEDOUT;
+		}
+		/* NACKs are expected while the IC boots: report the first few only */
+		if (st.probing || st.gpi_reports < 4 || (err != ENXIO && st.gpi_reports < 16)) {
+			st.gpi_reports++;
+			printf("SWEET TOUCH: gpi %s addr=%#x len=%u err=%d ev=%08x %08x %08x %08x "
+			    "ch=%u/%u rp=%#x/%#x evrp=%#x log=%#x\n", nr ? "read" : "write", addr,
+			    nr ? nr : nt, err, st.ev_last[0], st.ev_last[1], st.ev_last[2], st.ev_last[3],
+			    touch_gpi_state(GPI_CH(st.gpii, 0)), touch_gpi_state(GPI_CH(st.gpii, 1)),
+			    touch_rd(st.gpi, GPI_CH(st.gpii, 0) + GPI_CTX_RP_LO),
+			    touch_rd(st.gpi, GPI_CH(st.gpii, 1) + GPI_CTX_RP_LO),
+			    touch_rd(st.gpi, GPI_EV(st.gpii) + GPI_CTX_RP_LO),
+			    touch_rd(st.gpi, GPI_GPII(st.gpii) + GPI_ERROR_LOG));
+		}
+		(void)touch_gpi_restart();
+		return err;
+	}
+	if (nr) {
+		touch_dma_sync(GPI_RXBUF_OFF, nr);
+		memcpy(rx, (const void *)(st.dma + GPI_RXBUF_OFF), nr);
+	}
+	return 0;
+}
+
+/*
+ * The SE in GSI mode (Linux geni_se_select_gpi_mode), then one free GPII of
+ * the board's mask: event ring, both channels allocated and started
+ * (gpi_ch_init). Rings and bounce buffers share one contiguous page.
+ */
+static bool
+touch_gpi_init(void)
+{
+	st.gpi = ml_io_map(tb.gpi_pa, GPI_SIZE);
+	if (!st.gpi) {
+		printf("SWEET TOUCH: gpi %#x mapping failed\n", tb.gpi_pa);
+		return false;
+	}
+	unsigned n = 0;
+	for (; n < 13; ++n) {
+		if (!(tb.gpi_mask & (1u << n))) {
+			continue;
+		}
+		unsigned c0 = touch_gpi_state(GPI_CH(n, 0)), c1 = touch_gpi_state(GPI_CH(n, 1));
+		unsigned e = touch_gpi_state(GPI_EV(n));
+		printf("SWEET TOUCH: gpi gpii %u states ch %u/%u ev %u\n", n, c0, c1, e);
+		if (!c0 && !c1 && !e) {
+			break;  /* never allocated: nobody else drives it */
+		}
+	}
+	if (n == 13) {
+		printf("SWEET TOUCH: no unallocated GPII in mask %#x\n", tb.gpi_mask);
+		return false;
+	}
+	st.gpii = n;
+	if (kmem_alloc_contig(kernel_map, &st.dma, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET TOUCH: no contiguous DMA page\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)st.dma);
+	if (!pn) {
+		return false;
+	}
+	st.dma_pa = ptoa_64(pn);
+	touch_dma_sync(0, GPI_RXBUF_OFF + GPI_RXBUF_LEN);
+
+	touch_wr(st.se, 0xe1c, 0);                                      /* SE_IRQ_EN */
+	touch_wr(st.se, 0x644, touch_rd(st.se, 0x644) & ~1u);           /* S_CMD_DONE */
+	touch_wr(st.se, SE_IRQ_EN, touch_rd(st.se, SE_IRQ_EN) &
+	    ~(SE_DONE | SE_TX_WM_IRQ | SE_RX_WM_IRQ | SE_RX_LAST));
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);                            /* S_IRQ_CLEAR */
+	touch_wr(st.se, 0xc44, 0xffffffffu);                            /* DMA TX/RX IRQ clear */
+	touch_wr(st.se, 0xd44, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 1);                                     /* GENI_DMA_MODE_EN */
+	touch_wr(st.se, 0xe18, touch_rd(st.se, 0xe18) | 0xfu);          /* GSI DMA/M/S events */
+
+	/* gpi_config_interrupts with every source masked; IRQ (not MSI) signalling */
+	uint32_t g = GPI_GPII(n);
+	const uint32_t zero[] = {GPI_TYPE_MSK, GPI_IEOB_MSK, GPI_CH_IRQ_MSK, GPI_EV_IRQ_MSK,
+		                 GPI_GLOB_EN, GPI_GPII_EN, GPI_MSI_LO, GPI_MSI_HI, GPI_SCRATCH0,
+		                 GPI_SCRATCH1, GPI_ERROR_LOG};
+	for (unsigned i = 0; i < sizeof(zero) / sizeof(zero[0]); ++i) {
+		touch_wr(st.gpi, g + zero[i], 0);
+	}
+	touch_wr(st.gpi, g + GPI_INTSET, 1);
