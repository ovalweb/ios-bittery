+#define GPI_CH_IRQ      0x090u
+#define GPI_EV_IRQ      0x094u
+#define GPI_CH_IRQ_MSK  0x098u
+#define GPI_EV_IRQ_MSK  0x09cu
+#define GPI_CH_IRQ_CLR  0x0a0u
+#define GPI_EV_IRQ_CLR  0x0a4u
+#define GPI_IEOB_MSK    0x0b8u
+#define GPI_IEOB_CLR    0x0c0u
+#define GPI_GLOB_STTS   0x100u
+#define GPI_GLOB_EN     0x108u
+#define GPI_GLOB_CLR    0x110u
+#define GPI_GPII_STTS   0x118u
+#define GPI_GPII_EN     0x120u
+#define GPI_GPII_CLR    0x128u
+#define GPI_INTSET      0x180u
+#define GPI_MSI_LO      0x188u
+#define GPI_MSI_HI      0x18cu
+#define GPI_ERROR_LOG   0x200u
+#define GPI_SCRATCH0    0x400u
+#define GPI_SCRATCH1    0x404u
+#define GPI_CTX_CONFIG  0x00u       /* channel and event ring context words */
+#define GPI_CTX_LEN     0x04u
+#define GPI_CTX_BASE_LO 0x08u
+#define GPI_CTX_BASE_HI 0x0cu
+#define GPI_CTX_RP_LO   0x10u
+#define GPI_CTX_WP_LO   0x18u
+#define GPI_CTX_INT_MOD 0x20u
+#define GPI_CTX_MSI_LO  0x28u
+#define GPI_CTX_MSI_HI  0x2cu
+#define GPI_CTX_RPU_LO  0x30u
+#define GPI_CTX_RPU_HI  0x34u
+#define GPI_CH_QOS      0x5cu
+#define GPI_CH_SCRATCH  0x60u       /* 4 words: pair << 16 | protocol << 4 | SE id */
+#define GPI_CMD_ALLOC   0u
+#define GPI_CMD_START   1u
+#define GPI_CMD_STOP    2u
+#define GPI_CMD_RESET   9u
+#define GPI_ALLOCATED   1u          /* CHSTATE, bits 23:20 of CONFIG */
+#define GPI_STARTED     2u
+#define GPI_STOPPED     3u
+#define GPI_PROTO_I2C   3u
+#define GPI_EL          16u         /* TRE and event size */
+#define GPI_EV_LEN      2048u       /* rings: power of two, aligned to their length */
