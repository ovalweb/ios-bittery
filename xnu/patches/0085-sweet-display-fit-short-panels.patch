+/*
+ * Fit mode: scale the layer's logical rectangle [dx, dx + w) x [dy, dy + h)
+ * (from surface position sx, sy) onto the panel by nearest neighbour.
+ * The caller checked the rectangle against the surface memory.
+ */
+void
+AppleCLCD::presentFit(const SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	uint32_t c0 = 0, c1 = 0;
+
+	/* fFitX is ascending: the scaled columns whose source lies in the layer. */
+	while (c0 < fGeom.fit_w && fFitX[c0] < dx) {
+		c0++;
+	}
+	c1 = c0;
+	while (c1 < fGeom.fit_w && fFitX[c1] < dx + w) {
+		c1++;
+	}
+	if (c0 == c1) {
+		return;
+	}
+	for (uint32_t r = 0; r < fGeom.fit_h; r++) {
+		int32_t ly = fFitY[r];
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *in = (const uint32_t *)(src + s->offset +
+		    (uint64_t)(sy + ly - dy) * s->bytesPerRow + (uint64_t)sx * 4);
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)(fGeom.fit_y + r) * fRowBytes +
+		    (uint64_t)fGeom.fit_x * 4);
+		for (uint32_t c = c0; c < c1; c++) {
+			out[c] = in[fFitX[c] - dx];
+		}
+	}
+}
