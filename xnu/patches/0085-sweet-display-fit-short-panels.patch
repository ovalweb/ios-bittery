+/*
+ * Where the display that iOS sees lands on the real panel. The framebuffer
+ * (SweetFramebuffer.cpp) and the touch digitizer (hid/SweetHID.cpp) both
+ * use this, so a touch hits what is drawn under the finger.
+ *
+ * iOS only lays itself out for real iPhone screens, so a panel that fits
+ * inside it is presented as the iPhone X screen, 1125x2436 (boot-arg
+ * sweetfb_native=1 presents the panel itself). Then either
+ *   crop: the centered panel-sized part is shown 1:1 (sweet, 1080x2400
+ *         loses 18 rows at the top and bottom), or
+ *   fit:  the whole screen is scaled down to the panel height (nearest
+ *         neighbour) and centered. Default when cropping would lose more
+ *         than 4% of the height, e.g. the Pixel 3's 1080x2160 panel would
+ *         otherwise hide the status bar and the home indicator. Boot-arg
+ *         sweetfb_fit=0/1 forces either.
+ */
+#ifndef SWEET_DISPLAY_H
+#define SWEET_DISPLAY_H
+
+#include <stdint.h>
+#include <pexpert/pexpert.h>
+
+#define SWEET_DISPLAY_LOGICAL_W 1125
+#define SWEET_DISPLAY_LOGICAL_H 2436
+
+struct sweet_display_geometry {
+	uint32_t panel_w, panel_h;      /* boot framebuffer pixels */
+	uint32_t logical_w, logical_h;  /* size reported to userland */
+	int32_t  off_x, off_y;          /* crop: logical position of panel pixel 0,0 */
+	bool     fit;
+	uint32_t fit_w, fit_h;          /* fit: the scaled screen on the panel */
+	uint32_t fit_x, fit_y;          /* fit: its panel origin */
+};
+
+static inline bool
+sweet_display_geometry(struct sweet_display_geometry *g)
+{
+	PE_Video video;
+	int native = 0, fit = -1;
+
+	g->fit = false;
+	g->fit_w = g->fit_h = g->fit_x = g->fit_y = 0;
+	g->panel_w = g->panel_h = g->logical_w = g->logical_h = 0;
+	g->off_x = g->off_y = 0;
+	PE_current_console(&video);
+	if (video.v_width == 0 || video.v_height == 0) {
+		return false;
+	}
+	g->panel_w = (uint32_t)video.v_width;
+	g->panel_h = (uint32_t)video.v_height;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	PE_parse_boot_argn("sweetfb_fit", &fit, sizeof(fit));
+	g->logical_w = g->panel_w;
+	g->logical_h = g->panel_h;
+	if (!native && g->panel_w <= SWEET_DISPLAY_LOGICAL_W && g->panel_h <= SWEET_DISPLAY_LOGICAL_H) {
+		g->logical_w = SWEET_DISPLAY_LOGICAL_W;
+		g->logical_h = SWEET_DISPLAY_LOGICAL_H;
+	}
+	g->off_x = (int32_t)(g->logical_w - g->panel_w) / 2;
+	g->off_y = (int32_t)(g->logical_h - g->panel_h) / 2;
+	if (fit < 0) {
+		fit = (uint64_t)g->panel_h * 100 < (uint64_t)g->logical_h * 96;
+	}
+	g->fit = fit != 0 && (g->logical_w != g->panel_w || g->logical_h != g->panel_h);
+	if (g->fit) {
+		/* Largest logical_w:logical_h rectangle inside the panel. */
+		if ((uint64_t)g->panel_w * g->logical_h < (uint64_t)g->panel_h * g->logical_w) {
+			g->fit_w = g->panel_w;
+			g->fit_h = (uint32_t)((uint64_t)g->logical_h * g->panel_w / g->logical_w);
+		} else {
+			g->fit_h = g->panel_h;
+			g->fit_w = (uint32_t)((uint64_t)g->logical_w * g->panel_h / g->logical_h);
+		}
+		g->fit_x = (g->panel_w - g->fit_w) / 2;
+		g->fit_y = (g->panel_h - g->fit_h) / 2;
+	}
+	return true;
+}
+
+#endif
