+/*
+ * Bit-banged I2C on the SE's SDA/SCL pins (Linux i2c-gpio, i2c-algo-bit),
+ * for an SE without FIFO when GPI DMA is unusable. Open drain: a line is
+ * driven low (output, latch 0) or released to the bus pull-ups (input).
+ * About 100 kHz; the IC may stretch SCL.
+ */
+#define BB_HALF_US      5u
+
+static void
+touch_bb_line(const struct touch_pin *p, bool high)
+{
+	uint32_t cfg = touch_rd(p->va, 0) & ~0x3ffu;
+	touch_wr(p->va, 0, cfg | (p->mux << 2) | p->pull | (p->drive << 6) | (high ? 0u : 0x200u));
+}
+
+static bool
+touch_bb_scl_high(void)
+{
+	touch_bb_line(&tb.scl, true);
+	for (unsigned i = 0; i < 2000; ++i) {   /* clock stretching up to 2 ms */
+		if (touch_gpio_io(&tb.scl) & 1u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static int
+touch_bb_bit_out(bool b)
+{
+	touch_bb_line(&tb.sda, b);
+	delay(BB_HALF_US);
+	if (!touch_bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	delay(BB_HALF_US);
+	touch_bb_line(&tb.scl, false);
+	return 0;
+}
+
+static int
+touch_bb_bit_in(bool *b)
+{
+	touch_bb_line(&tb.sda, true);
+	delay(BB_HALF_US);
+	if (!touch_bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	delay(BB_HALF_US);
+	*b = (touch_gpio_io(&tb.sda) & 1u) != 0;
+	touch_bb_line(&tb.scl, false);
+	return 0;
+}
+
+/* START, or a repeated START after a stretched message: SDA falls, SCL high. */
+static int
+touch_bb_start(void)
+{
+	touch_bb_line(&tb.sda, true);
+	delay(BB_HALF_US);
+	if (!touch_bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	if (!(touch_gpio_io(&tb.sda) & 1u)) {
+		return EBUSY;   /* a device holds SDA */
+	}
+	delay(BB_HALF_US);
+	touch_bb_line(&tb.sda, false);
+	delay(BB_HALF_US);
+	touch_bb_line(&tb.scl, false);
+	return 0;
+}
+
+static void
+touch_bb_stop(void)
+{
+	touch_bb_line(&tb.sda, false);
+	delay(BB_HALF_US);
+	(void)touch_bb_scl_high();
+	delay(BB_HALF_US);
+	touch_bb_line(&tb.sda, true);
+	delay(BB_HALF_US);
+}
+
+/* 0 on ACK, ENXIO on NACK */
+static int
+touch_bb_byte_out(uint8_t v)
+{
+	bool nack = true;
+	for (int i = 7; i >= 0; --i) {
+		int err = touch_bb_bit_out(((v >> i) & 1u) != 0);
+		if (err) {
+			return err;
+		}
+	}
+	int err = touch_bb_bit_in(&nack);
+	return err ? err : nack ? ENXIO : 0;
+}
+
+static int
+touch_bb_byte_in(uint8_t *v, bool ack)
+{
+	unsigned x = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		bool b = false;
+		int err = touch_bb_bit_in(&b);
+		if (err) {
+			return err;
+		}
+		x = (x << 1) | (b ? 1u : 0u);
+	}
+	*v = (uint8_t)x;
+	return touch_bb_bit_out(!ack);
+}
+
+/* touch_msg_run on the bit-banged bus. */
+static int
+touch_bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!st.bb_ready) {
+		/* Bus recovery: clock out a device left mid-byte, then STOP. */
+		touch_wr(tb.sda.va, TOUCH_GPIO_IO, 0);  /* output latches low */
+		touch_wr(tb.scl.va, TOUCH_GPIO_IO, 0);
+		touch_bb_line(&tb.sda, true);
+		for (unsigned i = 0; i < 9 && !(touch_gpio_io(&tb.sda) & 1u); ++i) {
+			touch_bb_line(&tb.scl, false);
+			delay(BB_HALF_US);
+			(void)touch_bb_scl_high();
+			delay(BB_HALF_US);
+		}
+		touch_bb_stop();
+		printf("SWEET TOUCH: bb bus idle sda=%u scl=%u\n", touch_gpio_io(&tb.sda) & 1u,
+		    touch_gpio_io(&tb.scl) & 1u);
+		st.bb_ready = true;
+	}
+	int err = touch_bb_start();
+	if (!err) {
+		err = touch_bb_byte_out((uint8_t)((addr << 1) | (nr ? 1u : 0u)));
+	}
+	for (unsigned i = 0; !err && i < nt; ++i) {
+		err = touch_bb_byte_out(tx[i]);
+		if (err == ENXIO) {
+			err = EIO;      /* data NACK; ENXIO is reserved for the address */
+		}
+	}
+	for (unsigned i = 0; !err && i < nr; ++i) {
+		err = touch_bb_byte_in(&rx[i], i + 1 < nr);
+	}
+	if (err || !stretch) {
+		touch_bb_stop();
+	}
+	return err;
+}
