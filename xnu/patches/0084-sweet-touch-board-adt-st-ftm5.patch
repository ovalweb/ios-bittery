+/* Pixel 3 FTM5: reset, controller-ready, chip ID 36 39, sense on. */
+static bool
+touch_stfts_start(void)
+{
+	/* fts_chip_powercycle: reset held low with the rails up, then released. */
+	touch_gpio(&tb.reset, true, false);
+	touch_wait(10);
+	touch_gpio(&tb.reset, true, true);
+	int ready = touch_stfts_wait_ready(1000);
+	/* ADDR_DCHIP_ID 0x20000000 (36 39 on FTM5), ADDR_DCHIP_FW_VER at +4 */
+	uint8_t id[6] = {0, 0, 0, 0, 0, 0};
+	st.probing = true;
+	int ide = touch_stfts_hw_read(0x20000000u, id, sizeof(id));
+	st.probing = false;
+	printf("SWEET TOUCH: ftm5 ready=%d chip-id err=%d %02x %02x fw %02x%02x irq=%#x\n",
+	    ready, ide, id[0], id[1], id[5], id[4], touch_gpio_io(&tb.irq));
+	if (st.dead || ide || id[0] != 0x36 || id[1] != 0x39) {
+		printf("SWEET TOUCH: no FTM5 at %#x (want chip id 36 39); stopping\n", tb.addr);
+		return false;
+	}
+	int err = touch_stfts_sense_on();
+	if (err) {
+		printf("SWEET TOUCH: ftm5 sense on failed %d\n", err);
+		return false;
+	}
+	st.kind = TOUCH_STFTS;
+	printf("SWEET TOUCH: selected ST FTM5, %ux%u, poll=10ms irq-hint=%d\n",
+	    tb.max_x + 1, tb.max_y + 1, st.irq_hint);
+	return true;
+}
+
+/* sweet: GT9896 Yellowstone or Focaltech 54:52, whichever answers. */
+static bool
+touch_sweet_start(void)
+{
+	/* Vendor GT9896 dev_confirm: reset low 2 ms, then high. */
+	touch_gpio(&tb.reset, true, false);
+	touch_wait(2);
+	touch_gpio(&tb.reset, true, true);
+	touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+	st.probing = true;
+	int ge = touch_probe_info(GOODIX_PID_REG, gid);
+	printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	(void)touch_probe_info(0x8240, legacy);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	st.probing = false;
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		return false;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	printf("SWEET TOUCH: selected %s, %ux%u, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", tb.max_x + 1, tb.max_y + 1,
+	    st.irq_hint);
+	return true;
+}
