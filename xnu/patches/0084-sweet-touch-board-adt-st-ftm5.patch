+/*
+ * ST FTM5 (Pixel 3). Events are popped from the IC's FIFO by reading after
+ * command 0x86; byte 7 counts the events still queued. An empty FIFO reads
+ * as event 0x00.
+ */
+static int
+touch_stfts_event(uint8_t *ev)
+{
+	return touch_read((uint8_t)tb.addr, STFTS_FIFO_READ, false, ev, STFTS_EVENT_LEN);
+}
+
+/* Hardware register read: 0xfa + 32-bit address, data follows (no dummy byte). */
+static int
+touch_stfts_hw_read(uint32_t reg, uint8_t *buf, unsigned len)
+{
+	const uint8_t cmd[5] = {0xfa, (uint8_t)(reg >> 24), (uint8_t)(reg >> 16),
+		                (uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg((uint8_t)tb.addr, cmd, sizeof(cmd), NULL, 0, true);
+	return err ? err : touch_msg((uint8_t)tb.addr, NULL, 0, buf, len, false);
+}
+
+/* Wait for EVT_ID_CONTROLLER_READY after a reset; earlier events are dropped. */
+static int
+touch_stfts_wait_ready(unsigned ms)
+{
+	uint8_t ev[STFTS_EVENT_LEN];
+	int err = ETIMEDOUT;
+	for (unsigned waited = 0; waited < ms; waited += 10) {
+		touch_wait(10);
+		err = touch_stfts_event(ev);
+		if (err) {
+			continue;       /* still booting: NACKs are expected */
+		}
+		if (ev[0] == STFTS_EVT_READY) {
+			return 0;
+		}
+		if (ev[0] == STFTS_EVT_ERROR) {
+			printf("SWEET TOUCH: ftm5 boot error event %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3]);
+		}
+		err = ETIMEDOUT;
+	}
+	return err;
+}
+
+/* fts_mode_handler(resume): setScanMode(SCAN_MODE_ACTIVE, 0xff), all scans on. */
+static int
+touch_stfts_sense_on(void)
+{
+	const uint8_t cmd[3] = {0xa0, 0x00, 0xff};
+	return touch_msg((uint8_t)tb.addr, cmd, sizeof(cmd), NULL, 0, false);
+}
+
+/*
+ * Drain the FIFO (up to its 32 events) and report the resulting contacts.
+ * Enter/motion carry the slot in ev[1] >> 4 and a 12-bit position:
+ * x = (ev[3] & 0xf) << 8 | ev[2], y = ev[4] << 4 | ev[3] >> 4.
+ */
+static int
+touch_stfts(void)
+{
+	uint8_t ev[STFTS_EVENT_LEN];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	for (unsigned n = 0; n < 32; ++n) {
+		int err = touch_stfts_event(ev);
+		if (err) {
+			return err;
+		}
+		unsigned id = ev[1] >> 4, type = ev[1] & 15u;
+		switch (ev[0]) {
+		case 0x00:
+			n = 32;         /* FIFO empty */
+			break;
+		case STFTS_EVT_ENTER:
+		case STFTS_EVT_MOTION: {
+			unsigned px = ((unsigned)(ev[3] & 15u) << 8) | ev[2];
+			unsigned py = ((unsigned)ev[4] << 4) | (ev[3] >> 4);
+			if (id >= TOUCH_MAX || type == 0) {
+				break;
+			}
+			if (type == STFTS_TYPE_HOVER) {
+				mask &= ~(1u << id);    /* hover is not a contact */
+				break;
+			}
+			x[id] = (int)(px > tb.max_x ? tb.max_x : px);
+			y[id] = (int)(py > tb.max_y ? tb.max_y : py);
+			mask |= 1u << id;
+			break;
+		}
+		case STFTS_EVT_LEAVE:
+			if (id < TOUCH_MAX) {
+				mask &= ~(1u << id);
+			}
+			break;
+		case STFTS_EVT_READY:
+			/* The IC reset itself (ESD, watchdog): contacts are gone, sense is off. */
+			printf("SWEET TOUCH: ftm5 controller ready again; sense on\n");
+			mask = 0;
+			(void)touch_stfts_sense_on();
+			break;
+		case STFTS_EVT_ERROR:
+			printf("SWEET TOUCH: ftm5 error event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+			break;
+		default:
+			break;          /* status, user, debug events */
+		}
+		if ((ev[7] & 0x1fu) == 0) {
+			break;
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
