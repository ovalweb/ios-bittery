+#include <stdint.h>
+
+bool sweet_board_present(const char *node);
+/* false (and *out unchanged) when the node or a 4-byte property is absent */
+bool sweet_board_u32(const char *node, const char *prop, uint32_t *out);
+/* number of u32 cells copied, 0 when absent, empty or longer than max */
+unsigned int sweet_board_u32s(const char *node, const char *prop, uint32_t *out, unsigned int max);
+/* NUL-terminated string property that fits in len bytes */
+bool sweet_board_str(const char *node, const char *prop, char *out, size_t len);
+#endif
