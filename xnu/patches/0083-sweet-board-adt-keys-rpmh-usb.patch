+/*
+ * Optional per-board values from the ADT (tools/mkadt.py --board).
+ * The drivers keep the Redmi Note 10 Pro (sweet) values as defaults, so an
+ * ADT without these nodes boots exactly as before; another phone (e.g. the
+ * Pixel 3, blueline) describes its wiring in /sweet-keys, /sweet-touch,
+ * /sweet-rpmh and /sweet-usb instead of a second kernel build.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/device_tree.h>
+#include "sweet_board.h"
+
+static const void *
+sweet_board_prop(const char *node, const char *prop, unsigned int *size)
+{
+	DTEntry entry;
+	const void *value;
+
+	if (SecureDTLookupEntry(NULL, node, &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, prop, &value, size) != kSuccess) {
+		return NULL;
+	}
+	return value;
+}
+
+bool
+sweet_board_present(const char *node)
+{
+	DTEntry entry;
+
+	return SecureDTLookupEntry(NULL, node, &entry) == kSuccess;
+}
+
+bool
+sweet_board_u32(const char *node, const char *prop, uint32_t *out)
+{
+	unsigned int size = 0;
+	const void *value = sweet_board_prop(node, prop, &size);
+
+	if (value == NULL || size != sizeof(uint32_t)) {
+		return false;
+	}
+	memcpy(out, value, sizeof(uint32_t));
+	return true;
+}
+
+unsigned int
+sweet_board_u32s(const char *node, const char *prop, uint32_t *out, unsigned int max)
+{
+	unsigned int size = 0;
+	const void *value = sweet_board_prop(node, prop, &size);
+
+	if (value == NULL || size == 0 || (size % sizeof(uint32_t)) != 0 ||
+	    size / sizeof(uint32_t) > max) {
+		return 0;
+	}
+	memcpy(out, value, size);
+	return size / sizeof(uint32_t);
+}
+
+bool
+sweet_board_str(const char *node, const char *prop, char *out, size_t len)
+{
+	unsigned int size = 0;
+	const char *value = sweet_board_prop(node, prop, &size);
+
+	if (value == NULL || size == 0 || size > len || value[size - 1] != '\0') {
+		return false;
+	}
+	memcpy(out, value, size);
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
