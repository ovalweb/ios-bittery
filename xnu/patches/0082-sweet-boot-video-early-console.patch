+/*
+ * The console must stay inside the one 32MB block that start.s maps VA=PA
+ * and arm_vm_init aliases later: rows past the block end are not drawn.
+ */
+void
+sweet_early_init(uint64_t base, uint64_t width, uint64_t height, uint64_t row_bytes)
+{
+	const uint64_t block = 32ULL << 20;
+	uint64_t room = block - (base & (block - 1));
+
+	if (base == 0 || width == 0 || row_bytes < width * 4 || (row_bytes & 3)) {
+		early_disabled = 1;
+		return;
+	}
+	if (height > room / row_bytes) {
+		height = room / row_bytes;
+	}
+	if (height < 64) {
+		early_disabled = 1;
+		return;
+	}
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(row_bytes / 4);
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
