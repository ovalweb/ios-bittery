--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,61 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * Busy report: configd's InterfaceNamer only declares the network interfaces
+ * named once the IOKit registry is quiet; until then SCNetworkInterfaceCopyAll
+ * blocks (Settings > About froze on it). At 60 s and 180 s print every
+ * service that holds the registry busy and has no busy child: those are the
+ * ones whose matching/start never finished. sweetbusy=0 turns it off.
+ */
+static thread_call_t sweet_busy_call;
+static int sweet_busy_round;
+
+static void
+sweet_busy_report(thread_call_param_t, thread_call_param_t)
+{
+	IOService *root = IOService::getServiceRoot();
+	IOLog("SWEET BUSY: report %d: registry root busy %u\n", sweet_busy_round,
+	    root ? root->getBusyState() : 0);
+	IORegistryIterator *iter = root ? IORegistryIterator::iterateOver(root, gIOServicePlane,
+	    kIORegistryIterateRecursively) : NULL;
+	OSOrderedSet *all = iter ? iter->iterateAll() : NULL;
+	unsigned shown = 0;
+	for (unsigned i = 0; all && i < all->getCount() && shown < 24; ++i) {
+		IOService *s = OSDynamicCast(IOService, all->getObject(i));
+		if (!s || !s->getBusyState()) {
+			continue;
+		}
+		bool busy_child = false;
+		OSIterator *kids = s->getChildIterator(gIOServicePlane);
+		for (OSObject *o; kids && (o = kids->getNextObject());) {
+			IOService *k = OSDynamicCast(IOService, o);
+			if (k && k->getBusyState()) {
+				busy_child = true;
+				break;
+			}
+		}
+		OSSafeReleaseNULL(kids);
+		if (busy_child) {
+			continue;
+		}
+		IOService *p = s->getProvider();
+		IOLog("SWEET BUSY: '%s' <%s> busy %u, provider '%s'\n", s->getName(),
+		    s->getMetaClass()->getClassName(), s->getBusyState(), p ? p->getName() : "-");
+		shown++;
+	}
+	OSSafeReleaseNULL(all);
+	OSSafeReleaseNULL(iter);
+	if (++sweet_busy_round < 2) {
+		uint64_t deadline;
+		clock_interval_to_deadline(120, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(sweet_busy_call, deadline);
+	}
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -31,6 +86,13 @@ SweetPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+	int busy = 1;
+	(void)PE_parse_boot_argn("sweetbusy", &busy, sizeof(busy));
+	if (busy && (sweet_busy_call = thread_call_allocate(sweet_busy_report, NULL))) {
+		uint64_t deadline;
+		clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(sweet_busy_call, deadline);
+	}
 	return true;
 }
 
