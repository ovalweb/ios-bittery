+static int
+touch_smmu_match(unsigned nsmr, uint32_t sid)
+{
+	for (unsigned i = 0; i < nsmr; ++i) {
+		uint32_t smr = touch_rd(st.smmu, SMMU_SMR(i));
+		uint32_t mask = (smr >> 16) & 0x7fffu;
+		if ((smr & SMMU_SMR_VALID) && !((sid ^ smr) & ~mask & 0x7fffu)) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/*
+ * SDM845's hypervisor faults DMA from apps SMMU streams that have no stream
+ * mapping; Linux arm-smmu-qcom.c keeps the ones ABL left. ABL never used the
+ * GPI master, so give its stream a free SMR whose S2CR copies the one of a
+ * master ABL left working (UFS). sweettouchsmmu=0 only reports.
+ */
+static void
+touch_gpi_smmu(void)
+{
+	int enable = 1;
+	(void)PE_parse_boot_argn("sweettouchsmmu", &enable, sizeof(enable));
+	st.smmu = ml_io_map(tb.smmu_pa, 0x20000);
+	if (!st.smmu) {
+		printf("SWEET TOUCH: smmu %#x mapping failed\n", tb.smmu_pa);
+		return;
+	}
+	uint32_t scr0 = touch_rd(st.smmu, SMMU_SCR0), idr0 = touch_rd(st.smmu, SMMU_IDR0);
+	uint32_t gr1 = (touch_rd(st.smmu, SMMU_IDR1) & (1u << 31)) ? 0x10000u : 0x1000u;
+	unsigned nsmr = idr0 & 0xffu;
+	printf("SWEET TOUCH: smmu %#x scr0=%#x idr0=%#x (%u SMRs) gfsr=%#x synr1=%#x\n",
+	    tb.smmu_pa, scr0, idr0, nsmr, touch_rd(st.smmu, SMMU_GFSR),
+	    touch_rd(st.smmu, SMMU_GFSYNR1));
+	int free_smr = -1;
+	for (unsigned i = 0; i < nsmr; ++i) {
+		uint32_t smr = touch_rd(st.smmu, SMMU_SMR(i));
+		if (!(smr & SMMU_SMR_VALID)) {
+			if (free_smr < 0) {
+				free_smr = (int)i;
+			}
+			continue;
+		}
+		uint32_t s2cr = touch_rd(st.smmu, SMMU_S2CR(i));
+		printf("SWEET TOUCH: smmu smr%u id=%#x mask=%#x s2cr=%#x cbar=%#x\n", i,
+		    smr & 0x7fffu, (smr >> 16) & 0x7fffu, s2cr, ((s2cr >> 16) & 3u) ? 0u :
+		    touch_rd(st.smmu, gr1 + SMMU_CBAR(s2cr & 0xffu)));
+	}
+	int gm = touch_smmu_match(nsmr, tb.gpi_sid), rm = touch_smmu_match(nsmr, tb.ref_sid);
+	printf("SWEET TOUCH: smmu stream %#x -> smr %d, reference %#x -> smr %d, first free %d\n",
+	    tb.gpi_sid, gm, tb.ref_sid, rm, free_smr);
+	if (gm >= 0 || rm < 0 || free_smr < 0 || !enable) {
+		return;
+	}
+	touch_wait(1500);       /* the lines above reach the disk if the writes below are fatal */
+	uint32_t s2cr = touch_rd(st.smmu, SMMU_S2CR((unsigned)rm));
+	touch_wr(st.smmu, SMMU_S2CR((unsigned)free_smr), s2cr);
+	touch_wr(st.smmu, SMMU_SMR((unsigned)free_smr), SMMU_SMR_VALID | tb.gpi_sid);
+	printf("SWEET TOUCH: smmu smr%d now %#x s2cr %#x (copied %#x from smr%d)\n", free_smr,
+	    touch_rd(st.smmu, SMMU_SMR((unsigned)free_smr)),
+	    touch_rd(st.smmu, SMMU_S2CR((unsigned)free_smr)), s2cr, rm);
+}
