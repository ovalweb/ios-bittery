+/*
+ * QUSB2 v2 PHY bring-up, as Linux phy-qcom-qusb2.c does it for
+ * qcom,sdm845-qusb2-phy: the Pixel 3's ABL leaves the PHY disabled
+ * (PWR_CTRL1 = VREF_SUPPLY_TRIM | CLAMP_N_EN | POWER_DOWN), so the DWC3 had
+ * no UTMI clock and its endpoint commands timed out. Supplies from the
+ * Pixel 3 DT (vdd l1a 0.88 V, vdda-pll l12a 1.8 V, vdda-phy-dpdm l24a
+ * 3.088 V), the PHY reset GCC_QUSB2PHY_PRIM_BCR (0x12000), then the init
+ * table, power up, and CORE_READY. Efuse HSTX trim is not applied.
+ */
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+#define QUSB2_PWR_CTRL1         0x210
+#define QUSB2_PLL_STATUS        0x1a0
+#define QUSB2_POWER_DOWN        0x01u
+#define QUSB2_DISABLE           0x23u   /* VREF_SUPPLY_TRIM | CLAMP_N_EN | POWER_DOWN */
+#define GCC_QUSB2PHY_PRIM_BCR   0x12000
+
+static int
+ud_qusb2_init(void)
+{
+	static const struct {
+		uint16_t off;
+		uint8_t val;
+	} tbl[] = {
+		{0x004, 0x03}, {0x18c, 0x7c}, {0x02c, 0x80}, {0x184, 0x0a}, {0x0b4, 0x19},
+		{0x194, 0x40}, {0x198, 0x20}, {0x214, 0x21}, {0x220, 0x00}, {0x224, 0x58},
+		{0x240, 0x30}, {0x244, 0x29}, {0x248, 0xca}, {0x24c, 0x04}, {0x250, 0x03},
+		{0x23c, 0x00},
+	};
+	int v1 = sweet_rpmh_vreg_enable("ldoa1", 880);
+	int v12 = sweet_rpmh_vreg_enable("ldoa12", 1800);
+	int v24 = sweet_rpmh_vreg_enable("ldoa24", 3088);
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	if (!gcc || !phy) {
+		return -1;
+	}
+	uint32_t before = usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff;
+	*(volatile uint32_t *)(gcc + GCC_QUSB2PHY_PRIM_BCR) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(150);
+	*(volatile uint32_t *)(gcc + GCC_QUSB2PHY_PRIM_BCR) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(10);
+	*(volatile uint32_t *)(phy + QUSB2_PWR_CTRL1) = (usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff) | QUSB2_DISABLE;
+	for (unsigned i = 0; i < sizeof(tbl) / sizeof(tbl[0]); i++) {
+		*(volatile uint32_t *)(phy + tbl[i].off) = tbl[i].val;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(phy + QUSB2_PWR_CTRL1) = (usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff) & ~QUSB2_POWER_DOWN;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(300);
+	uint32_t status = usb_rd(phy, QUSB2_PLL_STATUS) & 0xff;
+	printf("SWEET USB: QUSB2 init: rails %d/%d/%d, PWR_CTRL1 %#x -> %#x, PLL_STATUS %#x (%s)\n",
+	    v1, v12, v24, before, usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff, status,
+	    (status & 1u) ? "core ready" : "NOT ready");
+	return (status & 1u) ? 0 : -1;
+}
