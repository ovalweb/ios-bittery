+{
+	int enabled = 1;
+	uint32_t pa;
+	if (!sweet_board_u32("/sweet-watchdog", "reg", &pa)) {
+		return;         /* the shim of this board does not arm one */
+	}
+	PE_parse_boot_argn("flamewdt", &enabled, sizeof(enabled));
+	volatile uint32_t *wdt = (volatile uint32_t *)ml_io_map(pa, 0x1000);
+	if (wdt == NULL) {
+		IOLog("FLAME WDT: mapping failed\n");
+		return;
+	}
+	if (!(wdt[FLAME_WDT_EN / 4] & 1)) {
+		IOLog("FLAME WDT: not armed by the shim\n");
+		return;
+	}
+	wdt[FLAME_WDT_RST / 4] = 1;
