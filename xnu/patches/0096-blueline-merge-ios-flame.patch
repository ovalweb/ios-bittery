+++ b/bsd/dev/sweet_cpufreq.c
@@ -0,0 +1,96 @@
+/*
+ * flame (SM8150) CPU frequency: the OSM hardware DCVS keeps a frequency
+ * table per cluster and takes a desired table index per cluster; voltage
+ * (CPR) and thermal limits (LMh) stay in hardware. ABL leaves the clusters
+ * slow and nothing under XNU raises them. Linux: drivers/clk/qcom/
+ * clk-cpu-osm.c (msm-4.14), bases from the live DT qcom,cpucc node.
+ *
+ * Boot-arg flamecpufreq: 0 leave as is, 1 (default) highest all-core
+ * frequency, N > 1 the highest entry at or below N MHz.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_cpufreq_init(void);
+
+#define OSM_FREQ_REG    0x110u          /* + 32 * index */
+#define OSM_ROW         32u
+#define OSM_ROWS        40u
+#define OSM_DESIRED     0x920u          /* + 4 * core in cluster; core 0 drives the policy */
+#define OSM_XO_KHZ      19200u
+
+/*
+ * Frequency domains (cpufreq-hw bases) from ADT /sweet-cpufreq "domains":
+ * flame 0x18323000 (A55 x4), 0x18325800 (A76 x3), 0x18327800 (A76 prime);
+ * SDM845 0x17d43000 (silver), 0x17d45800 (gold). No node: CPU clocks stay
+ * as the bootloader left them.
+ */
+#define OSM_MAX_DOMAINS 4u
+
+static uint32_t
+osm_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	unsigned want = 1;
+	uint32_t domains[OSM_MAX_DOMAINS];
+	unsigned ndomains = sweet_board_u32s("/sweet-cpufreq", "domains", domains, OSM_MAX_DOMAINS);
+	(void)PE_parse_boot_argn("flamecpufreq", &want, sizeof(want));
+	for (unsigned c = 0; c < ndomains; ++c) {
+		char name[16];
+		snprintf(name, sizeof(name), "domain %u", c);
+		vm_offset_t base = ml_io_map(domains[c], 0x1000);
+		if (!base) {
+			printf("SWEET CPUFREQ: %s: map failed\n", name);
+			continue;
+		}
+		uint32_t cur = osm_rd(base, OSM_DESIRED);
+		unsigned best = cur, best_khz = 0, prev_khz = 0, n = 0;
+		char line[256];
+		unsigned len = 0;
+		for (unsigned i = 0; i < OSM_ROWS; ++i) {
+			uint32_t data = osm_rd(base, OSM_FREQ_REG + i * OSM_ROW);
+			unsigned src = data >> 30, lval = data & 0xffu, cores = (data >> 16) & 7u;
+			unsigned khz = src ? OSM_XO_KHZ * lval : 300000u;
+			if (i > 0 && khz == prev_khz) {
+				break; /* a repeated frequency ends the table */
+			}
+			prev_khz = khz;
+			n = i + 1;
+			if (len < sizeof(line) - 16) {
+				len += snprintf(line + len, sizeof(line) - len, " %u%s", khz / 1000,
+				    cores == 1 ? "*" : "");
+			}
+			/* core count 1 = single-core boost entry: skip, as Linux does */
+			if (cores == 1 || (want > 1 && khz / 1000 > want)) {
+				continue;
+			}
+			if (khz > best_khz) {
+				best_khz = khz;
+				best = i;
+			}
+		}
+		printf("SWEET CPUFREQ: %s table (MHz, *=1-core boost):%s\n", name, line);
+		if (want == 0 || best_khz == 0 || best >= n) {
+			printf("SWEET CPUFREQ: %s index %u kept\n", name, cur);
+			continue;
+		}
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(base + OSM_DESIRED) = best;
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET CPUFREQ: %s index %u -> %u (%u MHz), reads back %u\n",
+		    name, cur, best, best_khz / 1000, osm_rd(base, OSM_DESIRED));
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,384 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   READ <path> <offset> <len>\n                  -> "OK <len>\n<bytes>"  (decimal; for
+ *                                                    devices, e.g. /dev/pmem at a PA)
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	if (!err) {
+		/* O_TRUNC through vnode_open does not shorten an existing file here: a smaller file kept the old tail */
+		err = vnode_setsize(vp, 0, 0, ctx);
+	}
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+/* Range read: works on character devices (vnode_size is 0 there). */
+static int
+sf_read(socket_t so, const char *path, uint64_t off, uint64_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err) {
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	/* Read the first chunk before replying, so a bad offset gives ERR. */
+	int chunk = (int)MIN((uint64_t)SF_BUF, len), resid = 0;
+	err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (err || resid) {
+		vnode_close(vp, FREAD, ctx);
+		sf_reply(so, err ? err : EIO, 0, false);
+		return err ? err : EIO;
+	}
+	sf_reply(so, 0, len, true);
+	for (uint64_t done = 0;;) {
+		err = sf_send(so, sf_buf, (size_t)chunk);
+		done += (uint64_t)chunk;
+		if (err || done >= len) {
+			break;
+		}
+		chunk = (int)MIN((uint64_t)SF_BUF, len - done);
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, (off_t)(off + done), UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err || resid) {
+			err = err ? err : EIO;
+			break;          /* short stream: the client sees a closed socket */
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	if (!strncmp(line, "READ ", 5)) {
+		char *p = line + 5, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		unsigned long long off = strtoul(sp + 1, &p, 10);   /* 64-bit long */
+		n = sf_dec(p);
+		err = sf_read(so, a, off, n);
+		printf("SWEET FILES: READ %s %llu %llu -> %d\n", a, off, n, err);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
