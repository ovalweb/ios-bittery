+/*
+ * USB reset from the host (Linux dwc3_gadget_reset_interrupt): end the data
+ * endpoints' transfers, clear their stalls and disable them, so the next
+ * SET_CONFIGURATION sets them up again. Before, a reset the Mac sent after
+ * a few minutes left the ECM endpoints dead: CLEAR_FEATURE(HALT) on 0x82
+ * forever, the link down.
+ */
+static void
+ud_reset_data_eps(void)
+{
+	static const unsigned eps[] = { EP_RX, EP_TX, EP_INT };
+	if (!ud.configured) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(eps) / sizeof(eps[0]); i++) {
+		(void)ud_epcmd(eps[i], DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | ((uint32_t)ud.rsc[eps[i]] << 16), 0, 0, 0);
+		delay(100);             /* no completion event asked for (Linux waits 100 us too) */
+		(void)ud_epcmd(eps[i], DEPCMD_CLEARSTALL, 0, 0, 0);
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	ud.tx_busy = false;
+	lck_mtx_unlock(ud.lock);
+	printf("SWEET USB: data endpoints stopped for the reset\n");
 }
 
