+/*
+ * PMI8998: the FG's monotonic SOC (0-255; 1-254 scale to 1-99 % as in
+ * fg_get_msoc), VBATT 122.07 uV/LSB, IBATT 488.281 uA/LSB (positive while
+ * discharging), SMB2 charger state 0-4 charging, 5 terminated (full).
+ */
+void
+SweetBattery::pollPmi8998(void)
+{
+	uint8_t msoc, usb, charger;
+	uint16_t rawVoltage, rawCurrent;
+	bool valid = fReal &&
+	    !sweet_spmi_read(fSid, 0x4009, &msoc) &&
+	    readWord(fSid, 0x41a0, &rawVoltage) &&
+	    !sweet_spmi_read(fSid, 0x1310, &usb) &&
+	    !sweet_spmi_read(fSid, 0x1006, &charger);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u) : 0;
+	/* A stopped gauge or a misread must not become an empty battery. */
+	valid = valid && mv >= 2800 && mv <= 4600 && !(msoc == 0 && mv > 3500);
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	unsigned percent = msoc == 255 ? 100 : msoc == 0 ? 0 :
+	    ((msoc - 1u) * 98u + 126u) / 253u + 1u;
+	bool external = (usb & 0x10u) != 0;
+	unsigned state = charger & 7u;
+	bool charging = external && state <= 4;
+	bool full = external && state == 5;
+	int ma = 0;
+	bool currentValid = readWord(fSid, 0x41a2, &rawCurrent);
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+	}
+	publish(full ? 100 : percent, mv, ma, external, external, charging, full, true,
+	    currentValid);
+}
