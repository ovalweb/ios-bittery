+	wr32(GMU_REG(GMU_H2G_SET), 1u << OOB_DCVS_ACK);	/* clear (a6xx_gmu_clear_oob) */
+	uint32_t ret = rd32(GMU_REG(GMU_DCVS_RET));
+	return rc || ret ? -1 : 0;
+}
