+/* Set an OOB request and wait for its ack (a6xx_gmu_set_oob); the ack is cleared either way. */
+static int gmu_oob(unsigned set, unsigned ack, const char *what)
+{
+	wr32(GMU_REG(GMU_H2G_SET), 1u << set);
+	int rc = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << ack, 1, 1000);
+	wr32(GMU_REG(GMU_G2H_CLR), 1u << ack);
+	a6_log("oob %s %s (g2h info %x)\n", what, rc ? "TIMEOUT" : "acked", rd32(GMU_REG(GMU_G2H_INFO)));
+	return rc;
+}
