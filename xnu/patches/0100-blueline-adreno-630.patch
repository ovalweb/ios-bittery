+/* Legacy GPU frequency change (a6xx_gmu_set_freq): DCVS registers plus the DCVS OOB. */
+static int gmu_legacy_dcvs(uint32_t lvl)
+{
+	wr32(GMU_REG(GMU_DCVS_ACK), 0);
+	wr32(GMU_REG(GMU_DCVS_PERF), (3u << 28) | lvl);
